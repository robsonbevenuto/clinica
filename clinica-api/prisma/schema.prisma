generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(100)
  email     String    @unique @db.VarChar(100)
  senha     String    @db.VarChar(255)
  role      String    @default("secretario") @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("usuarios")
}

model Medico {
  id            Int        @id @default(autoincrement())
  nome          String     @db.VarChar(100)
  especialidade String     @db.VarChar(100)
  email         String?    @unique @db.VarChar(100)
  telefone      String?    @db.VarChar(20)
  createdAt     DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  consultas     Consulta[]

  @@map("medicos")
}

model Paciente {
  id             Int        @id @default(autoincrement())
  nome           String     @db.VarChar(100)
  cpf            String     @unique @db.VarChar(14)
  email          String?    @db.VarChar(100)
  telefone       String?    @db.VarChar(20)
  dataNascimento DateTime?  @map("data_nascimento") @db.Date
  createdAt      DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  consultas      Consulta[]

  @@map("pacientes")
}

model Consulta {
  id          Int       @id @default(autoincrement())
  data        DateTime  @db.Timestamp(6)
  turno       String?   @db.VarChar(20)   
  medicoId    Int       @map("medico_id")
  pacienteId  Int       @map("paciente_id")
  status      String?   @default("agendada") @db.VarChar(20)
  observacoes String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  medico      Medico    @relation(fields: [medicoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paciente    Paciente  @relation(fields: [pacienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("consultas")
}
